# Copy to .env and adjust. Never commit the real .env file.
ALLOWED_ORIGINS=http://localhost:5173
CONFIDENCE_THRESHOLD=0.70
USE_STUB_MODEL=true
MODEL_VERSION=stub-0.1
# Creates demo@example.com / demo-password at start-up. Set to false in production.
SEED_DEMO_USER=true
